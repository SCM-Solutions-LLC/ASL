  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/effects": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/motion-blur": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/shapes": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "setup": "bash tools/setup.sh",
    "lint": "node tools/check-alignment.mjs && node tools/check-scripts.mjs && node tools/check-licences.mjs && eslint src && tsc",
    "align": "python3 -I tools/align.py",
    "new-short": "node tools/new-short.mjs",
    "publishable": "node tools/check-licences.mjs --publish && node tools/check-factcheck.mjs",
    "tts": ".venv/bin/python -I tools/tts.py",
    "sheet": ".venv/bin/python -I tools/sheet.py",
    "sfx": ".venv/bin/python -I tools/sfx.py"
  },
  "allowScripts": {
    "esbuild": false
  }
